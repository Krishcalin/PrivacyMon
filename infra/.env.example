# PrivacyMon dev-stack environment (copy to infra/.env; .env is gitignored).
# The platform database the API and worker connect to. Inside the compose network
# the host is the `postgres` service name on its internal port 5432. The dev
# credentials here are non-secret; production supplies a real secret out of band.
PRIVACYMON_ENV=development
PRIVACYMON_DB_URL=postgresql://privacymon:privacymon@postgres:5432/privacymon
# Scan execution: "celery" uses the background worker via Redis; "inline" runs in the
# request (dev / no broker).
PRIVACYMON_SCAN_MODE=celery
PRIVACYMON_BROKER_URL=redis://redis:6379/0
# AES-256 master key (base64, 32 bytes) for the credential vault — encrypts stored
# read-only target passwords. Generate with: python -c "from platform_db import crypto; print(crypto.new_master_key())"
PRIVACYMON_MASTER_KEY=change-me-base64-32-bytes
# Auth: JWT signing secret, the restricted DB role the API uses for scoped reads
# (RLS enforcement), and the first-administrator bootstrap (applied once, empty users).
PRIVACYMON_JWT_SECRET=change-me-to-a-long-random-string
PRIVACYMON_APP_DB_URL=postgresql://privacymon_app:privacymon_app@postgres:5432/privacymon
PRIVACYMON_BOOTSTRAP_ADMIN_EMAIL=admin@privacymon.local
PRIVACYMON_BOOTSTRAP_ADMIN_PASSWORD=change-me

# ── Continuous monitoring: optional notifications ──────────────────────────────
# SMTP for change-alert emails (leave PRIVACYMON_SMTP_HOST unset to disable email).
# PRIVACYMON_SMTP_HOST=smtp.example.com
# PRIVACYMON_SMTP_PORT=587
# PRIVACYMON_SMTP_USER=privacymon
# PRIVACYMON_SMTP_PASSWORD=change-me
# PRIVACYMON_SMTP_FROM=privacymon@example.com
# PRIVACYMON_SMTP_TLS=1
# Comma-separated fallback recipients when the settings table has none.
# PRIVACYMON_NOTIFY_EMAILS=dpo@example.com,security@example.com
