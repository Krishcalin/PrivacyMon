# PrivacyMon environment template. Copy to infra/.env and adjust.
# Secrets in real deployments come from the vault or Kubernetes secrets,
# never from this file (SRS 11.2, 12.3).

PRIVACYMON_ENV=development

# Platform database
DATABASE_URL=postgresql+asyncpg://privacymon:privacymon@postgres:5432/privacymon

# Queue / cache
REDIS_URL=redis://redis:6379/0

# Object store (rendered reports)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=privacymon
S3_SECRET_KEY=privacymon
S3_BUCKET=privacymon-reports

# Detection thresholds (SRS 4.4)
PRIVACYMON_LIKELY=0.80
PRIVACYMON_REVIEW=0.50

# OIDC (Foundation increment) — values from the corporate IdP test realm
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Credential encryption fallback when no external vault is configured (SRS 7.1)
ENVELOPE_KEK=change-me-32-byte-base64-key
