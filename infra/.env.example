# PrivacyMon dev-stack environment (copy to infra/.env; .env is gitignored).
# The platform database the API and worker connect to. Inside the compose network
# the host is the `postgres` service name on its internal port 5432. The dev
# credentials here are non-secret; production supplies a real secret out of band.
PRIVACYMON_ENV=development
PRIVACYMON_DB_URL=postgresql://privacymon:privacymon@postgres:5432/privacymon
# Scan execution: "celery" uses the background worker via Redis; "inline" runs in the
# request (dev / no broker).
PRIVACYMON_SCAN_MODE=celery
PRIVACYMON_BROKER_URL=redis://redis:6379/0
# AES-256 master key (base64, 32 bytes) for the credential vault — encrypts stored
# read-only target passwords. Generate with: python -c "from platform_db import crypto; print(crypto.new_master_key())"
PRIVACYMON_MASTER_KEY=change-me-base64-32-bytes
